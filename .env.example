# Required for LLM calls
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional search integration
TAVILY_API_KEY=

# Google OAuth files remain local and must never be committed
GOOGLE_CLIENT_SECRET_FILE=credentials.json
GOOGLE_TOKEN_DIR=tokens
DEFAULT_TIMEZONE=Europe/Paris

# Local application state
MEMORY_INDEX_DIR=data/faiss_index
APPLICATIONS_FILE=data/applications.json

# Public atomic demo profile. Point this to data/profile_memories.json for a private local profile.
PROFILE_MEMORIES_FILE=data/profile_memories.atomic.json

# Disabled by default. Enable only for a FAISS index generated locally and trusted.
ALLOW_TRUSTED_FAISS_DESERIALIZATION=false
