# LLM provider order
# Supported values: openai, anthropic
LLM_PROVIDER=openai
LLM_FALLBACK_PROVIDER=anthropic

# OpenAI primary provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Low-latency model used only for CV profile extraction. Falls back to OPENAI_MODEL on errors.
OPENAI_PROFILE_MODEL=gpt-4.1-nano

# Optional Anthropic fallback provider
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Optional dedicated Anthropic model for CV profile extraction.
ANTHROPIC_PROFILE_MODEL=claude-sonnet-4-6

# Profile retrieval
# Dense stage: public sentence-transformers/all-MiniLM-L6-v2 embeddings + FAISS.
# Premium default: dense retrieval + deterministic BM25 + reciprocal-rank fusion,
# then a small cross-encoder reranker on the fused candidate pool.
# HF_TOKEN is intentionally not required; public models are cached locally.
RETRIEVAL_STRATEGY=hybrid
RETRIEVAL_CANDIDATE_K=16
RETRIEVAL_RRF_K=60
RETRIEVAL_RERANK_K=12
RETRIEVAL_RERANKER_ENABLED=true
RETRIEVAL_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Optional search integration
TAVILY_API_KEY=

# Local Google OAuth: desktop/installed-app flow and filesystem token storage.
GOOGLE_CLIENT_SECRET_FILE=credentials.json
GOOGLE_TOKEN_DIR=tokens
DEFAULT_TIMEZONE=Europe/Paris

# Hosted Google OAuth: Google Web application flow + encrypted persistent token storage.
# Keep disabled until the Google Cloud OAuth client and redirect URI are configured.
HOSTED_GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Example: https://jobcopilot-recruiter-ai.streamlit.app/
GOOGLE_OAUTH_REDIRECT_URI=
# High-entropy server-only secret, minimum 32 characters. Never commit a real value.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Deployment persistence
# auto = Supabase when URL + server secret are configured, otherwise local filesystem.
PERSISTENCE_BACKEND=auto
SUPABASE_URL=
# Preferred current server key from Supabase Connect / API Keys: sb_secret_...
SUPABASE_SECRET_KEY=
# Legacy JWT service-role keys remain supported as a migration fallback only:
# SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TIMEOUT_SECONDS=12

# Hosted recruiter demo
# Enable on Streamlit Community Cloud. Google actions remain off unless
# HOSTED_GOOGLE_OAUTH_ENABLED is also true and all hosted OAuth secrets are configured.
HOSTED_RECRUITER_DEMO=false

# Legacy single-user local application state used by evaluation and command-line tooling.
MEMORY_INDEX_DIR=data/faiss_index
APPLICATIONS_FILE=data/applications.json
PROFILE_MEMORIES_FILE=data/profile_memories.atomic.json

# Private beta multi-user state
BETA_AUTH_ENABLED=false
BETA_USERS_FILE=data/beta_users.json
USER_DATA_ROOT=data/users

# Maximum paid AI actions per user and calendar day.
# One CV extraction, application analysis or Agent Chat turn consumes one unit.
BETA_DAILY_AI_LIMIT=10

# Optional name used for local-demo email signatures when authentication is disabled.
# Authenticated beta accounts use their configured display_name automatically.
LOCAL_CANDIDATE_NAME=

# Disabled by default. Enable only for FAISS indexes generated locally and trusted.
ALLOW_TRUSTED_FAISS_DESERIALIZATION=false
