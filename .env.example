# LLM provider order
# Supported values: openai, anthropic
LLM_PROVIDER=openai
LLM_FALLBACK_PROVIDER=anthropic

# OpenAI primary provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional Anthropic fallback provider
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional search integration
TAVILY_API_KEY=

# Google OAuth client remains shared; refresh/access tokens are user-scoped in private beta mode.
GOOGLE_CLIENT_SECRET_FILE=credentials.json
GOOGLE_TOKEN_DIR=tokens
DEFAULT_TIMEZONE=Europe/Paris

# Legacy single-user local application state used by evaluation and command-line tooling.
MEMORY_INDEX_DIR=data/faiss_index
APPLICATIONS_FILE=data/applications.json
PROFILE_MEMORIES_FILE=data/profile_memories.atomic.json

# Private beta multi-user state
BETA_AUTH_ENABLED=false
BETA_USERS_FILE=data/beta_users.json
USER_DATA_ROOT=data/users

# Maximum paid AI actions per user and calendar day.
# One CV extraction, application analysis or Agent Chat turn consumes one unit.
BETA_DAILY_AI_LIMIT=10

# Optional name used for local-demo email signatures when authentication is disabled.
# Authenticated beta accounts use their configured display_name automatically.
LOCAL_CANDIDATE_NAME=

# Disabled by default. Enable only for FAISS indexes generated locally and trusted.
ALLOW_TRUSTED_FAISS_DESERIALIZATION=false
